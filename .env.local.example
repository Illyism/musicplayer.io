# Reddit web app credentials: https://www.reddit.com/prefs/apps
# Required for Reddit listing reads as well as user sign-in.
REDDIT_CLIENT_ID=your_client_id
REDDIT_CLIENT_SECRET=your_client_secret
REDDIT_USERNAME=your_reddit_username

# Register this exact callback address in the Reddit web app settings.
# Production example: https://musicplayer.io/auth/callback
REDDIT_REDIRECT_URI=http://localhost:3000/auth/callback
